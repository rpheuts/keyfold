{
  "id": "folded_portrait",
  "name": "Cover Screen Portrait Terminal",
  "height": {
    "mode": "percentage",
    "fallbackPercent": 36
  },
  "rows": [
    {
      "keys": [
        { "label": "ESC", "code": "ESCAPE", "type": "action", "width": 1.1 },
        { "label": "TAB", "code": "TAB", "type": "action", "width": 1.1 },
        { "label": "CTRL", "code": "CTRL", "type": "modifier", "sticky": true, "width": 1.2 },
        { "label": "ALT", "code": "ALT", "type": "modifier", "sticky": true, "width": 1.1 },
        { "label": "~", "output": "~", "width": 1.0 },
        { "label": "/", "output": "/", "width": 1.0 },
        { "label": "-", "output": "-", "width": 1.0 },
        { "label": "|", "output": "|", "width": 1.0 },
        { "label": "⌫", "code": "DEL", "type": "action", "repeat": true, "width": 1.3 }
      ]
    },
    {
      "keys": [
        { "label": "q", "shift": "1", "output": "q", "shiftOutput": "1" },
        { "label": "w", "shift": "2", "output": "w", "shiftOutput": "2" },
        { "label": "e", "shift": "3", "output": "e", "shiftOutput": "3" },
        { "label": "r", "shift": "4", "output": "r", "shiftOutput": "4" },
        { "label": "t", "shift": "5", "output": "t", "shiftOutput": "5" },
        { "label": "y", "shift": "6", "output": "y", "shiftOutput": "6" },
        { "label": "u", "shift": "7", "output": "u", "shiftOutput": "7" },
        { "label": "i", "shift": "8", "output": "i", "shiftOutput": "8" },
        { "label": "o", "shift": "9", "output": "o", "shiftOutput": "9" },
        { "label": "p", "shift": "0", "output": "p", "shiftOutput": "0" }
      ]
    },
    {
      "keys": [
        { "label": "a", "shift": "!", "output": "a", "shiftOutput": "!" },
        { "label": "s", "shift": "@", "output": "s", "shiftOutput": "@" },
        { "label": "d", "shift": "#", "output": "d", "shiftOutput": "#" },
        { "label": "f", "shift": "$", "output": "f", "shiftOutput": "$" },
        { "label": "g", "shift": "%", "output": "g", "shiftOutput": "%" },
        { "label": "h", "shift": "^", "output": "h", "shiftOutput": "^" },
        { "label": "j", "shift": "&", "output": "j", "shiftOutput": "&" },
        { "label": "k", "shift": "*", "output": "k", "shiftOutput": "*" },
        { "label": "l", "shift": ":", "output": "l", "shiftOutput": ":" },
        { "label": "⏎", "code": "ENTER", "type": "action", "width": 1.5 }
      ]
    },
    {
      "keys": [
        { "label": "⇧", "code": "SHIFT", "type": "modifier", "sticky": true, "width": 1.4 },
        { "label": "z", "shift": "_", "output": "z", "shiftOutput": "_" },
        { "label": "x", "shift": "=", "output": "x", "shiftOutput": "=" },
        { "label": "c", "shift": "+", "output": "c", "shiftOutput": "+" },
        { "label": "v", "shift": "[", "output": "v", "shiftOutput": "[" },
        { "label": "b", "shift": "]", "output": "b", "shiftOutput": "]" },
        { "label": "n", "shift": "{", "output": "n", "shiftOutput": "{" },
        { "label": "m", "shift": "}", "output": "m", "shiftOutput": "}" },
        { "label": ".", "shift": "?", "output": ".", "shiftOutput": "?" },
        { "label": "▲", "code": "DPAD_UP", "type": "action", "repeat": true, "width": 1.2 }
      ]
    },
    {
      "keys": [
        { "label": "FN", "code": "FN", "type": "layer", "width": 1.1 },
        { "label": " ", "output": " ", "code": "SPACE", "width": 3.8 },
        { "label": "◀", "code": "DPAD_LEFT", "type": "action", "repeat": true, "width": 1.1 },
        { "label": "▼", "code": "DPAD_DOWN", "type": "action", "repeat": true, "width": 1.1 },
        { "label": "▶", "code": "DPAD_RIGHT", "type": "action", "repeat": true, "width": 1.1 },
        { "label": "⚙", "code": "SETTINGS", "type": "action", "width": 1.0 }
      ]
    }
  ]
}
